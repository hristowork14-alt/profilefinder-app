# ─────────────────────────────────────────────────────────────────────────────
# ProfileFinder environment variables
# Copy this file to `.env` for local development. Never commit `.env`.
# On Netlify, add the same names under Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (public — these end up in the browser bundle, that is expected) ──
# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Leave false for the real app. `npm run dev:demo` turns it on automatically (see .env.demo).
VITE_DEMO_MODE=false

# ── Netlify Functions only (SECRET — never add a VITE_ prefix to these) ──
# Same Project URL as above
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → "Secret key" (starts with sb_secret_). Bypasses RLS: keep it secret.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Which web search API to use. Supported: serper
SEARCH_PROVIDER=serper
# serper.dev → Dashboard → API Key
SERPER_API_KEY=

# console.anthropic.com → API Keys. If empty, the app ranks with the built-in heuristic instead.
ANTHROPIC_API_KEY=
# Current model IDs: https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional. How hard the model thinks: low (default, fastest), medium, high,
# or "default" to not send the setting (use this if a model rejects it).
ANTHROPIC_EFFORT=low

# Fresh (non-cached) searches allowed per user per hour
MAX_SEARCHES_PER_HOUR=30

# true = use built-in fixture data instead of Serper, Anthropic and homepage fetching.
# Supabase (login, history) is still real. Useful before you have Serper/Anthropic keys.
USE_MOCKS=false
